{
  "name": "pixinsight-mcp",
  "version": "0.1.0",
  "description": "MCP server bridging AI assistants with PixInsight for astrophotography processing",
  "type": "module",
  "main": "agents/mcp/server.mjs",
  "scripts": {
    "start": "node agents/mcp/server.mjs",
    "doctor": "node scripts/pi-doctor.mjs",
    "launch": "node scripts/pi-launch.mjs",
    "lint:pjsr": "node scripts/pjsr-lint.mjs",
    "setup-bridge": "mkdir -p ~/.pixinsight-mcp/bridge/{commands,results,logs} ~/.pixinsight-mcp/catalog/recipes"
  },
  "keywords": [
    "pixinsight",
    "mcp",
    "astrophotography",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^1.15.1",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "bin": {
    "pixinsight-mcp": "agents/mcp/server.mjs"
  }
}
