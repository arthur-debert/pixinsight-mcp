{
  "planetary_nebula": {
    "description": "Small, round, faint shells. M97 (Owl), M27 (Dumbbell), M57 (Ring), NGC 7293 (Helix)",
    "characteristics": {
      "typical_size": "small",
      "dynamic_range": "low",
      "has_bright_core": false,
      "color_signature": "emission",
      "star_density": "moderate"
    },
    "stretch": {
      "target_median": 0.11,
      "headroom": 0.08
    },
    "tools": {
      "GC": {
        "use": true
      },
      "ABE": {
        "use": "try",
        "reason": "Compare with GC if gradients persist"
      },
      "BXT": {
        "use": true,
        "correct_only": true
      },
      "SPCC": {
        "use": true
      },
      "SCNR": {
        "use": "try",
        "reason": "Only if SPCC fails"
      },
      "NXT": {
        "use": true,
        "denoise_linear": 0.2,
        "denoise_post_stretch": 0.25
      },
      "SXT": {
        "use": true,
        "safe": true
      },
      "LHE": {
        "use": true,
        "start_amount": 0.35,
        "start_radius": 64,
        "mask_blur": 8,
        "mask_clipLow": 0.06
      },
      "HDRMT": {
        "use": "core_only",
        "inverted": true,
        "layers": 5,
        "iterations": 1,
        "reason": "Apply ONLY through core zone mask \u2014 compresses core dynamic range to reveal detail. Do NOT apply globally (flattens faint structure). v7-v9 showed core burns without it."
      },
      "LRGB": {
        "use": "avoid",
        "reason": "v3 showed native LRGB crushes PN brightness. Use RGB-only + PixelMath L enhancement instead."
      },
      "Ha_injection": {
        "use": true,
        "reason": "MANDATORY for HaLRGB \u2014 enhances shell structure. Use max_output=0.85 to prevent R burning."
      }
    },
    "saturation": {
      "rgb_initial": 0.75,
      "composition_target": 0.85,
      "hue_selective": true,
      "max_p90": 0.8
    },
    "burn": {
      "max_bright_block_pct": 3.0
    },
    "stars": {
      "screen_blend_strength": 1.0,
      "prominence": "prominent"
    },
    "notes": "Focus on revealing internal structure (eyes, shells) AND outer halo. Color is teal/blue for OIII-dominant + red/pink for Ha. OUTER HALO is a key differentiator \u2014 apply shadow-lifting curves through inverted luminance mask to make it OBVIOUSLY visible. Push OIII saturation hard (blue/teal). Background should reveal faint outer structure, not be crushed to black. RGB-only + PixelMath L enhancement preferred over native LRGB (which crushes brightness).",
    "learned_overrides": {
      "avoid_native_lrgb": true,
      "shadow_lift_mandatory": true,
      "oiii_saturation_push": "aggressive"
    }
  },
